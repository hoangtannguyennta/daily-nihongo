<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0 text-dark fw-bold">Quản lý Bảng chữ cái</h1>
      <p class="text-muted small mb-0">Hiragana và Katakana</p>
    </div>
    <%= link_to new_admin_kana_path, class: "btn btn-primary rounded-pill px-4 fw-bold shadow-sm" do %>
      <i class="bi bi-plus-circle me-2"></i>Thêm chữ mới
    <% end %>
  </div>

  <div class="card dashboard-card border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table vocab-table align-middle mb-0">
          <thead>
            <tr>
              <th class="ps-4">Ký tự</th>
              <th class="text-center">Romaji</th>
              <th class="text-center">Loại</th>
              <th class="text-center" style="width: 200px;">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% @kanas.each do |kana| %>
              <tr>
                <td class="ps-4">
                  <span class="fs-4 fw-bold text-primary"><%= kana.character %></span>
                </td>
                <td class="text-center">
                  <code class="px-2 py-1 bg-light rounded text-dark"><%= kana.romaji %></code>
                </td>
                <td class="text-center">
                  <span class="badge rounded-pill <%= kana.kind == 'hiragana' ? 'bg-primary' : 'bg-success' %>">
                    <%= kana.kind.capitalize %>
                  </span>
                </td>
                <td class="text-center pe-4">
                  <%= link_to edit_admin_kana_path(kana), class: "btn-action-custom btn-edit-custom me-2" do %>
                    <i class="bi bi-pencil-square"></i> Sửa
                  <% end %>
                  <%= link_to admin_kana_path(kana), class: "btn-action-custom btn-delete-custom", data: { turbo_method: :delete, turbo_confirm: 'Xóa chữ cái này?' } do %>
                    <i class="bi bi-trash"></i> Xóa
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>