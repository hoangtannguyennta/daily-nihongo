<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card vocab-card shadow border-0">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
              <i class="bi bi-person-badge text-primary fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Xin chào!</h3>
            <p class="text-muted small">Chào mừng bạn quay trở lại với JP Learning</p>
          </div>

          <%= form_with url: sessions_path, local: true do |form| %>
            <% if flash[:alert] %>
              <div class="alert alert-danger border-0 small py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= flash[:alert] %>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :email, "Email", class: "form-label small fw-bold text-secondary" %>
              <%= form.email_field :email, required: true, class: "form-control form-control-lg bg-light border-0 fs-6", placeholder: "email@example.com" %>
            </div>

            <div class="mb-3">
              <%= form.label :password, "Mật khẩu", class: "form-label small fw-bold text-secondary" %>
              <%= form.password_field :password, required: true, class: "form-control form-control-lg bg-light border-0 fs-6", placeholder: "••••••••" %>
            </div>

            <div class="d-grid mt-4">
              <%= form.submit "Đăng nhập", class: "btn btn-primary fw-bold py-3 rounded-pill shadow-sm" %>
            </div>
          <% end %>

          <div class="text-center mt-4">
            <p class="small text-muted mb-0">Bạn chưa có tài khoản? <%= link_to "Đăng ký ngay", signup_path, class: "text-primary text-decoration-none fw-bold" %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>