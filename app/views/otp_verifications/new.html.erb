<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
  <div class="card shadow border-0 rounded-4 p-4" style="max-width: 400px; width: 100%;">
    <div class="card-body p-0">
      <div class="text-center mb-4">
        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-shield-check text-primary" viewBox="0 0 16 16">
            <path d="M8 14.933a.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067v13.866zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
            <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
          </svg>
        </div>
        <h2 class="fw-bold h4">Xác nhận OTP</h2>
        <p class="text-muted small">
          Mã xác thực đã được gửi đến:<br>
          <span class="fw-bold text-primary"><%= @email %></span>
        </p>
      </div>

      <% if flash[:alert] %>
        <div class="alert alert-danger border-0 small py-2 mb-4 text-center">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: otp_verifications_path, method: :post do |f| %>
        <%= hidden_field_tag :email, @email %>
        
        <div class="mb-4">
          <label for="otp_code" class="form-label small fw-bold text-muted text-uppercase tracking-wider">Mã xác thực</label>
          <%= text_field_tag :otp_code, nil, 
              placeholder: "123456", 
              required: true, 
              maxlength: 6,
              pattern: "\\d{6}",
              class: "form-control form-control-lg text-center fw-bold border-2",
              style: "letter-spacing: 0.5rem; font-size: 1.5rem;" %>
        </div>

        <div class="d-grid gap-3">
          <%= f.submit "Kích hoạt tài khoản", class: "btn btn-primary py-2 fw-bold shadow-sm" %>
          
          <div class="d-flex justify-content-between align-items-center mt-1">
            <small class="text-muted">Không nhận được mã?</small>
            <%= link_to "Gửi lại mã", resend_otp_verifications_path(email: @email), data: { turbo_method: :post }, class: "small fw-bold text-decoration-none" %>
          </div>
        </div>
      <% end %>

      <div class="mt-4 pt-3 border-top text-center">
        <%= link_to login_path, class: "text-decoration-none text-muted small" do %>
          ← Quay lại đăng nhập
        <% end %>
      </div>
    </div>
  </div>
</div>