<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="display-6 fw-bold text-dark mb-1">Tổng điểm bài tập</h1>
      <p class="text-muted mb-0">Theo dõi kết quả luyện tập của bạn</p>
    </div>
    <%= link_to vocabularies_path, class: "btn btn-outline-secondary rounded-pill px-3" do %>
      <i class="bi bi-arrow-left"></i> Quay lại kho từ vựng
    <% end %>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-4 bg-primary text-white p-4">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="mb-1 opacity-75">Tổng điểm tích lũy</p>
            <h2 class="display-5 fw-bold mb-0"><%= @total_score %></h2>
          </div>
          <i class="bi bi-trophy-fill display-4 opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-4 bg-info text-white p-4">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="mb-1 opacity-75">Tổng số câu đã làm</p>
            <h2 class="display-5 fw-bold mb-0"><%= @total_questions %></h2>
          </div>
          <i class="bi bi-check-circle-fill display-4 opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-4 bg-success text-white p-4">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="mb-1 opacity-75">Số bài đã hoàn thành</p>
            <h2 class="display-5 fw-bold mb-0"><%= @total_successful %></h2>
          </div>
          <i class="bi bi-journals display-4 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-bold">Lịch sử làm bài</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-muted">
          <tr>
            <th class="ps-4">Ngày làm bài</th>
            <th>Bài học</th>
            <th class="text-center">Số câu đúng</th>
            <th class="text-center">Tỷ lệ</th>
          </tr>
        </thead>
        <tbody>
          <% @test_attempts.each do |attempt| %>
            <tr>
              <td class="ps-4">
                <div class="fw-medium"><%= attempt.created_at.strftime("%d/%m/%Y") %></div>
                <small class="text-muted"><%= attempt.created_at.strftime("%H:%M") %></small>
              </td>
              <td><span class="badge bg-soft-primary text-primary rounded-pill px-3">Bài <%= attempt.lesson&.number %></span></td>
              <td class="text-center fw-bold text-primary">
                <%= attempt.score %> / <%= attempt.total_questions %>
              </td>
              <td class="text-center">
                <% percent = (attempt.score.to_f / attempt.total_questions * 100).round(0) rescue 0 %>
                <div class="d-flex align-items-center justify-content-center">
                  <div class="progress flex-grow-1 mx-2" style="height: 6px; max-width: 100px;">
                    <div class="progress-bar bg-success" style="width: <%= percent %>%"></div>
                  </div>
                  <small class="fw-bold"><%= percent %>%</small>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .bg-soft-primary { background-color: #e0e7ff; }
</style>