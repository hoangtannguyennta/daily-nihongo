<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card dashboard-card border-0 p-4">
        <div class="text-center mb-4">
          <div class="stat-icon-box bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-person-gear fs-2"></i>
          </div>
          <h2 class="h4 fw-bold mb-1">Sửa thông tin</h2>
          <p class="text-muted small text-break">Cập nhật tài khoản: <%= @user.email %></p>
        </div>

        <%= render 'form', user: @user %>

        <div class="text-center mt-4">
          <%= link_to admin_users_path, class: "text-decoration-none text-muted small fw-bold" do %>
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>