<div class="container-fluid py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-5">
    <div>
      <h1 class="h3 mb-0 text-dark fw-bold">Bảng điều khiển Admin</h1>
      <p class="text-muted small mb-0">Tổng quan tình hình học tập của hệ thống</p>
    </div>
    <div>
      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
        <i class="bi bi-circle-fill me-1 small"></i> Hệ thống Live
      </span>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card dashboard-card border-0 border-start border-primary border-4 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small fw-bold text-uppercase mb-1">Tổng số người học</p>
              <h2 class="display-6 fw-bold mb-0 text-dark"><%= @total_users %></h2>
            </div>
            <div class="stat-icon-box bg-primary-subtle text-primary rounded-3">
              <i class="bi bi-people fs-3"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card dashboard-card border-0 border-start border-success border-4 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small fw-bold text-uppercase mb-1">User mới (Tuần này)</p>
              <h2 class="display-6 fw-bold mb-0 text-dark">+<%= @new_users_this_week %></h2>
            </div>
            <div class="stat-icon-box bg-success-subtle text-success rounded-3">
              <i class="bi bi-person-plus fs-3"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card dashboard-card border-0 border-start border-warning border-4 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small fw-bold text-uppercase mb-1">Tổng số từ vựng</p>
              <h2 class="display-6 fw-bold mb-0 text-dark text-break"><%= @total_vocabularies %></h2>
            </div>
            <div class="stat-icon-box bg-warning-subtle text-warning rounded-3">
              <i class="bi bi-book fs-3"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Users Table -->
  <div class="card dashboard-card border-0 shadow-sm overflow-hidden">
    <div class="card-header bg-white py-3 border-0">
      <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Người dùng đăng ký gần đây</h5>
    </div>
    <div class="table-responsive">
      <table class="table vocab-table align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="ps-4">ID</th>
            <th>Email</th>
            <th class="text-center">Vai trò</th>
            <th class="pe-4 text-end">Ngày tham gia</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_users.each do |user| %>
            <tr>
              <td class="ps-4 fw-bold text-muted">#<%= user.id %></td>
              <td class="fw-medium"><%= user.email %></td>
              <td class="text-center">
                <span class="badge rounded-pill <%= user.role == 'admin' ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-info-subtle text-info border border-info-subtle' %>">
                  <%= user.role == "admin" ? "Admin" : "Học viên" %>
                </span>
              </td>
              <td class="pe-4 text-end text-muted small"><%= user.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>