<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="text-center mb-4">
        <div class="stat-icon-box bg-warning text-white mx-auto mb-3 shadow-sm" style="width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-shield-lock-fill fs-2"></i>
        </div>
        <h2 class="fw-bold text-dark">Xác thực OTP</h2>
        <p class="text-muted small">Vui lòng nhập mã 6 chữ số đã được gửi tới email của bạn</p>
      </div>

      <div class="card dashboard-card border-0 p-4 shadow-sm" style="border-radius: 20px;">
        <div class="card-body">
          <% if flash[:alert] %>
            <div class="alert alert-danger border-0 rounded-3 mb-4 small text-center">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <%= form_with(url: otp_verifications_path, method: :post, local: true) do |f| %>
            <div class="mb-4">
              <div class="d-flex justify-content-center gap-2">
                <%= f.text_field :otp, 
                    class: "form-control border-0 bg-light p-3 text-center fs-3 fw-bold tracking-widest", 
                    placeholder: "• • • • • •", 
                    maxlength: 6, 
                    style: "letter-spacing: 0.5rem;",
                    required: true,
                    autofocus: true %>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "Xác nhận đăng ký", class: "btn btn-primary rounded-pill fw-bold py-3 shadow-sm" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="text-center mt-4">
        <p class="text-muted small">
          Không nhận được mã? 
          <%= link_to "Quay lại đăng ký", signup_path, class: "text-primary fw-bold text-decoration-none" %>
        </p>
      </div>
    </div>
  </div>
</div>