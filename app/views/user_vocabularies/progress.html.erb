<div class="container py-5">
  <div class="mb-5">
    <h1 class="display-5 fw-bold text-dark mb-1">Tiến độ học tập</h1>
    <p class="text-muted">Theo dõi hành trình chinh phục tiếng Nhật của bạn</p>
  </div>

  <!-- Overall Statistics Cards -->
  <div class="row g-4 mb-5">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100 text-center p-3">
        <div class="card-body">
          <div class="display-6 fw-bold text-primary mb-1"><%= @total_count %></div>
          <div class="text-muted small text-uppercase fw-bold">Tổng số từ</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100 text-center p-3">
        <div class="card-body">
          <div class="display-6 fw-bold text-success mb-1"><%= @remembered_count %></div>
          <div class="text-muted small text-uppercase fw-bold">Đã thuộc</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100 text-center p-3">
        <div class="card-body">
          <div class="display-6 fw-bold text-warning mb-1"><%= @not_remembered_count %></div>
          <div class="text-muted small text-uppercase fw-bold">Chưa thuộc</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100 text-center p-3">
        <div class="card-body">
          <div class="display-6 fw-bold text-secondary mb-1"><%= @not_learned_count %></div>
          <div class="text-muted small text-uppercase fw-bold">Chưa học</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Overall Progress Bar -->
  <div class="card border-0 shadow-sm p-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0">Tiến độ tổng thể</h4>
      <span class="badge bg-primary fs-5"><%= @overall_progress %>%</span>
    </div>
    <div class="progress" style="height: 25px; border-radius: 50px;">
      <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
           role="progressbar" 
           style="width: <%= @overall_progress %>%" 
           aria-valuenow="<%= @overall_progress %>" 
           aria-valuemin="0" 
           aria-valuemax="100"></div>
    </div>
  </div>

  <!-- Progress by Lesson -->
  <div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-header bg-white py-3 border-0">
      <h5 class="fw-bold mb-0">Chi tiết theo bài học</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="ps-4">Bài học</th>
            <th>Tiến độ</th>
            <th class="text-center">Số từ</th>
            <th class="text-center">Trạng thái</th>
            <th class="text-end pe-4">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% @lesson_stats.each do |stat| %>
            <tr>
              <td class="ps-4 fw-bold"><%= stat[:name] %></td>
              <td style="width: 40%;">
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar bg-info" style="width: <%= stat[:percent] %>%"></div>
                </div>
                <small class="text-muted mt-1 d-block"><%= stat[:percent] %>% hoàn thành</small>
              </td>
              <td class="text-center">
                <span class="fw-bold text-success"><%= stat[:remembered] %></span> / <%= stat[:total] %>
              </td>
              <td class="text-center">
                <% if stat[:percent] == 100 %>
                  <span class="badge bg-success-subtle text-success rounded-pill">Hoàn thành</span>
                <% elsif stat[:percent] > 0 %>
                  <span class="badge bg-info-subtle text-info rounded-pill">Đang học</span>
                <% else %>
                  <span class="badge bg-light text-muted rounded-pill">Chưa học</span>
                <% end %>
              </td>
              <td class="text-end pe-4">
                <div class="d-flex justify-content-end gap-2">
                  <%= link_to vocabularies_path(lesson_id: stat[:id]), class: "btn btn-sm btn-outline-primary rounded-pill", title: "Học từ vựng" do %>
                    <i class="bi bi-book me-1"></i> Học ngay
                  <% end %>
                  <%= link_to quiz_vocabularies_path(lesson_id: stat[:id]), class: "btn btn-sm btn-outline-success rounded-pill", title: "Luyện tập Quiz" do %>
                    <i class="bi bi-controller me-1"></i> Quiz
                  <% end %>
                  <%= link_to test_attempts_path(lesson_id: stat[:id]), class: "btn btn-sm btn-primary rounded-pill", title: "Bắt đầu làm bài kiểm tra" do %>
                    <i class="bi bi-card-checklist me-1"></i> Kiểm tra
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>